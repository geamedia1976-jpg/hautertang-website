# 複製本檔為 .env（本機開發用），或直接在 Vercel 後台設定環境變數
# ⚠️ 本檔只放「範例」，真正的金鑰請勿寫進 Git

# 綠界商店代號
ECPAY_MERCHANT_ID=3508165
# 綠界介接 HashKey / HashIV
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# production=正式環境（預設） / stage=測試環境
ECPAY_MODE=production
# Google Apps Script 網址（登記資料寫入試算表用，可留空）
GAS_URL=
# 網站正式網址（綠界回傳網址用，留空則自動帶入 Vercel 網址）
SITE_URL=https://你的網址/
